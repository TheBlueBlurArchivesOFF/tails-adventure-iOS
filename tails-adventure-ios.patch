@@ -0,0 +1,46 @@
+#ifndef TA_ACHIEVEMENTS_SECTION_H
+#define TA_ACHIEVEMENTS_SECTION_H
+
+#include <string>
+#include <vector>
+#include "font.h"
+#include "main_menu_section.h"
+#include "sound.h"
+#include "tools.h"
+#include "touchscreen.h"
+
+class TA_AchievementsSection : public TA_MainMenuSection {
+public:
+    using TA_MainMenuSection::TA_MainMenuSection;
+    void load() override;
+    TA_MainMenuState update() override;
+    void draw() override;
+    void setAlpha(int alpha) override { baseAlpha = alpha; }
+    void reset() override;
+
+private:
+    struct Row {
+        std::vector<std::string> nameLines, descriptionLines;
+        float y = 0, height = 0;
+    };
+
+    static constexpr float listTop = 26, lineHeight = 9, rowGap = 6, textLeft = 10;
+    static constexpr float boxSize = 11, boxRight = 10, scrollKeySpeed = 2.5F, scrollSlowdown = 0.125F;
+
+    void layout();
+    std::vector<std::string> wrap(const std::string& text, float width);
+    float getListBottom() const { return static_cast<float>(TA::screenHeight) - 6; }
+    float getMaxScroll() const;
+    void drawCheckbox(float x, float y, bool checked);
+    void drawFillRect(float x, float y, float w, float h, int r, int g, int b);
+
+    TA_Font font;
+    TA_Sound backSound;
+    TA_OnscreenButton backButton;
+    std::vector<Row> rows;
+    float totalHeight = 0, scroll = 0, scrollVelocity = 0, layoutWidth = -1;
+    int alpha = 255, baseAlpha = 255;
+    bool quit = false;
+};
+
+#endif // TA_ACHIEVEMENTS_SECTION_H
