+option(TA_FORCE_TOUCH "Compile touchscreen code path on any platform (for testing)" OFF)
+set(TA_IOS_BUNDLE_ID "local.tailsadventure.ios" CACHE STRING "iOS bundle identifier")
+set(TA_IOS_VERSION "0.3.2" CACHE STRING "iOS app version")
+set(TA_IOS_BUILD "1" CACHE STRING "iOS app build number")
 
