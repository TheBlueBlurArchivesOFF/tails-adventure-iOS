+// Draws centered text near the bottom of the screen. Lines break at '\n', and lines that would not fit the screen
+// are wrapped at spaces. The font is monospaced, so the wrapping stays the same while the letters are scrambled.
+void TA_DataSelectSection::drawSplashText(const std::string& text) {
+    const int maxChars = std::max(8, static_cast<int>((TA::screenWidth - 8) / 6));
+
+    std::vector<std::string> lines;
+    std::stringstream paragraphs(text);
+    std::string paragraph;
+    while(std::getline(paragraphs, paragraph, '\n')) {
+        std::string line;
+        std::stringstream words(paragraph);
+        std::string word;
+        // keep runs of spaces out of the way: words are separated by single spaces when wrapping
+        while(words >> word) {
+            if(!line.empty() && static_cast<int>(line.size() + 1 + word.size()) > maxChars) {
+                lines.push_back(line);
+                line = word;
+            } else {
+                line = line.empty() ? word : line + " " + word;
+            }
+        }
+        lines.push_back(line);
+    }
+
+    float top = TA::screenHeight - 20 - (9 * static_cast<int>(lines.size())) / 2;
+    for(size_t i = 0; i < lines.size(); i++) {
+        splashFont.drawTextCentered(top + 9 * i, lines[i], TA_Point(-1, 0));
+    }
 }
 
