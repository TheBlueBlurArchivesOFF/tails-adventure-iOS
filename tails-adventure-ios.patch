diff --git a/CMakeLists.txt b/CMakeLists.txt
index ff8768a..68d9588 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -6,6 +6,10 @@ option(TA_UNIX_INSTALL "Install on Unix filesystem" OFF)
 option(TA_LTO "Enable link time optimization" ON)
 option(TA_SANITIZE "Build with sanitizers" OFF)
 option(TA_CLANG_TIDY "Run clang-tidy alongside with building" OFF)
+option(TA_FORCE_TOUCH "Compile touchscreen code path on any platform (for testing)" OFF)
+set(TA_IOS_BUNDLE_ID "local.tailsadventure.ios" CACHE STRING "iOS bundle identifier")
+set(TA_IOS_VERSION "0.3.2" CACHE STRING "iOS app version")
+set(TA_IOS_BUILD "1" CACHE STRING "iOS app build number")
 
 set(CMAKE_CXX_STANDARD 23)
 
@@ -29,6 +33,10 @@ if(ANDROID)
     add_compile_definitions(_LIBCPP_HAS_NO_OFF_T_FUNCTIONS)
 endif()
 
+if(TA_FORCE_TOUCH)
+    add_compile_definitions(TA_FORCE_TOUCH)
+endif()
+
 if(TA_SANITIZE)
     add_compile_options(-fsanitize=address,leak,undefined)
     add_link_options(-fsanitize=address,leak,undefined)
@@ -128,10 +136,37 @@ file(GLOB_RECURSE TA_SOURCES src/*.cpp)
 
 if(ANDROID)
     add_library(tails-adventure SHARED ${TA_SOURCES})
+elseif(IOS)
+    add_executable(tails-adventure MACOSX_BUNDLE ${TA_SOURCES})
 else()
     add_executable(tails-adventure ${TA_SOURCES} ${WIN32_RESOURCES})
 endif()
 
+if(IOS)
+    set(TA_IOS_EXECUTABLE tails-adventure)
+    set(TA_IOS_MIN_VERSION "${CMAKE_OSX_DEPLOYMENT_TARGET}")
+    configure_file(res/ios/Info.plist.in ${CMAKE_BINARY_DIR}/Info.plist @ONLY)
+    set_target_properties(tails-adventure PROPERTIES
+        MACOSX_BUNDLE_INFO_PLIST ${CMAKE_BINARY_DIR}/Info.plist
+        XCODE_ATTRIBUTE_PRODUCT_BUNDLE_IDENTIFIER ${TA_IOS_BUNDLE_ID}
+        XCODE_ATTRIBUTE_TARGETED_DEVICE_FAMILY "1,2"
+        XCODE_ATTRIBUTE_ENABLE_BITCODE NO
+    )
+
+    # game data and app icons are plain files inside the bundle
+    set(TA_BUNDLE_DIR "$<TARGET_BUNDLE_DIR:tails-adventure>")
+    file(GLOB TA_IOS_ICONS res/ios/*.png)
+    add_custom_command(TARGET tails-adventure POST_BUILD
+        COMMAND ${CMAKE_COMMAND} -E remove_directory "${TA_BUNDLE_DIR}/assets"
+        COMMAND ${CMAKE_COMMAND} -E copy_directory "${CMAKE_SOURCE_DIR}/assets" "${TA_BUNDLE_DIR}/assets"
+        COMMAND ${CMAKE_COMMAND} -E copy
+            "${CMAKE_SOURCE_DIR}/external/SDL_GameControllerDB/gamecontrollerdb.txt" "${TA_BUNDLE_DIR}/assets/"
+        COMMAND ${CMAKE_COMMAND} -E copy ${TA_IOS_ICONS} "${TA_BUNDLE_DIR}/"
+        COMMENT "Copying assets into app bundle"
+        VERBATIM
+    )
+endif()
+
 target_compile_options(tails-adventure PRIVATE -ffast-math)
 
 if(TA_CLANG_TIDY)
@@ -190,17 +225,19 @@ if(WIN32)
     target_link_options(tails-adventure PRIVATE -mwindows)
 endif()
 
-if(TA_UNIX_INSTALL)
-    target_compile_options(tails-adventure PRIVATE -DTA_UNIX_INSTALL)
-    install(TARGETS tails-adventure DESTINATION /usr/local/bin)
-    install(DIRECTORY assets/ DESTINATION /usr/local/share/tails-adventure)
-    install(FILES external/SDL_GameControllerDB/gamecontrollerdb.txt DESTINATION /usr/local/share/tails-adventure)
-    install(FILES res/tails-adventure.png DESTINATION /usr/local/share/icons)
-    if(NOT APPLE)
-        install(FILES res/tails-adventure.desktop DESTINATION /usr/local/share/applications)
+if(NOT IOS)
+    if(TA_UNIX_INSTALL)
+        target_compile_options(tails-adventure PRIVATE -DTA_UNIX_INSTALL)
+        install(TARGETS tails-adventure DESTINATION /usr/local/bin)
+        install(DIRECTORY assets/ DESTINATION /usr/local/share/tails-adventure)
+        install(FILES external/SDL_GameControllerDB/gamecontrollerdb.txt DESTINATION /usr/local/share/tails-adventure)
+        install(FILES res/tails-adventure.png DESTINATION /usr/local/share/icons)
+        if(NOT APPLE)
+            install(FILES res/tails-adventure.desktop DESTINATION /usr/local/share/applications)
+        endif()
+    else()
+        install(TARGETS tails-adventure DESTINATION ${CMAKE_BINARY_DIR}/output)
+        install(DIRECTORY assets DESTINATION ${CMAKE_BINARY_DIR}/output)
+        install(FILES external/SDL_GameControllerDB/gamecontrollerdb.txt DESTINATION ${CMAKE_BINARY_DIR}/output/assets)
     endif()
-else()
-    install(TARGETS tails-adventure DESTINATION ${CMAKE_BINARY_DIR}/output)
-    install(DIRECTORY assets DESTINATION ${CMAKE_BINARY_DIR}/output)
-    install(FILES external/SDL_GameControllerDB/gamecontrollerdb.txt DESTINATION ${CMAKE_BINARY_DIR}/output/assets)
 endif()
