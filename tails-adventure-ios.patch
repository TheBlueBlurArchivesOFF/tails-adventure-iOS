diff --git a/src/engine/platform.h b/src/engine/platform.h
new file mode 100644
index 0000000..1f39dd4
--- /dev/null
+++ b/src/engine/platform.h
@@ -0,0 +1,12 @@
+#ifndef TA_PLATFORM_H
+#define TA_PLATFORM_H
+
+#include "SDL3/SDL_platform_defines.h"
+
+// Platforms where the game is controlled with a touchscreen by default (on-screen buttons, "touch to start" etc.)
+// TA_FORCE_TOUCH may be defined at configure time to compile the touch code path on any platform (for testing).
+#if defined(__ANDROID__) || defined(SDL_PLATFORM_IOS) || defined(TA_FORCE_TOUCH)
+#define TA_TOUCH_PLATFORM
+#endif
+
