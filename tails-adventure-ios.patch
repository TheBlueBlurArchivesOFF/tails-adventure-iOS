+
+void TA_Hud::startAchievementPopup(const std::string& name) {
+    auto center = [](const std::string& text) {
+        int total = popupWidth - static_cast<int>(text.size());
+        int left = std::max(0, total / 2);
+        int right = std::max(0, total - left);
+        return std::string(left, ' ') + text + std::string(right, ' ');
+    };
+
+    popupLines.clear();
+    popupLines.push_back(center("achievement finished!"));
+
+    std::string lower = name;
+    for(char& ch : lower) {
+        ch = static_cast<char>(std::tolower(static_cast<unsigned char>(ch)));
+    }
+    std::string line;
+    size_t pos = 0;
+    while(pos < lower.size()) {
+        size_t end = lower.find(' ', pos);
+        if(end == std::string::npos) {
+            end = lower.size();
+        }
+        std::string word = lower.substr(pos, end - pos);
+        pos = end + 1;
+        if(!line.empty() && line.size() + 1 + word.size() > popupWidth - 2) {
+            popupLines.push_back(center(line));
+            line = word;
+        } else {
+            line = line.empty() ? word : line + " " + word;
+        }
+    }
+    if(!line.empty()) {
+        popupLines.push_back(center(line));
+    }
+
+    popupTimer = 0;
+    popupActive = true;
+}
+
+void TA_Hud::updateAchievementPopup() {
+    if(!popupActive) {
+        std::string name;
+        if(TA::achievements::popPending(name)) {
+            startAchievementPopup(name);
+        }
+        return;
+    }
+
+    popupTimer += TA::elapsedTime;
+    if(popupTimer > popupShowTime) {
+        popupActive = false;
+    }
+}
+
+void TA_Hud::drawAchievementPopup() {
+    if(!popupActive || popupLines.empty()) {
+        return;
+    }
+
+    TA_Point position{popupX, popupY};
+    if(popupTimer < popupAppearTime) {
+        float factor = popupTimer / popupAppearTime;
+        popupFont.setAlpha(255 * factor);
+        position.x += popupShift * (1 - factor);
+    } else if(popupTimer > popupShowTime - popupAppearTime) {
+        float factor = (popupTimer - (popupShowTime - popupAppearTime)) / popupAppearTime;
+        popupFont.setAlpha(255 * (1 - factor));
+        position.x -= popupShift * factor;
+    } else {
+        popupFont.setAlpha(255);
+    }
+
+    for(const std::string& line : popupLines) {
+        popupFont.drawText(position, line, {-1, 0});
+        position.y += 8;
     }
 }
 
