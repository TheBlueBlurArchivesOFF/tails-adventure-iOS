index 0000000..0cb9b2e
--- /dev/null
+++ b/src/ui/achievements_section.cpp
@@ -0,0 +1,175 @@
+#include "achievements_section.h"
+#include <algorithm>
+#include <sstream>
+#include "SDL3/SDL_render.h"
+#include "achievements.h"
+#include "tools.h"
+
+void TA_AchievementsSection::load() {
+    font.loadFont("fonts/achievements.toml");
+    backSound.load("sound/select.ogg", TA_SOUND_CHANNEL_SFX2);
+    backButton.setRectangle({0, 0}, {128, 32});
+    layout();
+}
+
+void TA_AchievementsSection::reset() {
+    scroll = 0;
+    scrollVelocity = 0;
+    quit = false;
+}
+
+std::vector<std::string> TA_AchievementsSection::wrap(const std::string& text, float width) {
+    std::vector<std::string> lines;
+    std::stringstream stream(text);
+    std::string word, line;
+    while(stream >> word) {
+        std::string candidate = line.empty() ? word : line + " " + word;
+        if(!line.empty() && font.getTextWidth(candidate, {-1, 0}) > width) {
+            lines.push_back(line);
+            line = word;
+        } else {
+            line = candidate;
+        }
+    }
+    if(!line.empty()) {
+        lines.push_back(line);
+    }
+    return lines;
+}
+
+void TA_AchievementsSection::layout() {
+    layoutWidth = static_cast<float>(TA::screenWidth);
+    float textWidth = layoutWidth - textLeft - boxRight - boxSize - 6;
+
+    rows.clear();
+    float y = 0;
+    for(int index = 0; index < TA::achievements::getCount(); index++) {
+        const TA::achievements::Info& info = TA::achievements::get(index);
+        std::string name = info.name, description = info.description;
+        for(std::string* text : {&name, &description}) {
+            for(char& ch : *text) {
+                ch = static_cast<char>(std::tolower(static_cast<unsigned char>(ch)));
+            }
+        }
+
+        Row row;
+        row.nameLines = wrap(name, textWidth);
+        row.descriptionLines = wrap(description, textWidth);
+        row.y = y;
+        row.height = (row.nameLines.size() + row.descriptionLines.size()) * lineHeight;
+        y += row.height + rowGap;
+        rows.push_back(row);
+    }
+    totalHeight = y;
+}
+
+float TA_AchievementsSection::getMaxScroll() const {
+    return std::max(0.0F, totalHeight - (getListBottom() - listTop));
+}
+
+TA_MainMenuState TA_AchievementsSection::update() {
+    if(layoutWidth != static_cast<float>(TA::screenWidth)) {
+        layout();
+    }
+
+    backButton.update();
+
+    if(controller->isTouchscreen()) {
+        if(TA::touchscreen::isScrolling()) {
+            scrollVelocity = TA::touchscreen::getScrollVector().y;
+        } else if(!TA::equal(scrollVelocity, 0)) {
+            if(scrollVelocity > 0) {
+                scrollVelocity = std::max(0.0F, scrollVelocity - scrollSlowdown * TA::elapsedTime);
+            } else {
+                scrollVelocity = std::min(0.0F, scrollVelocity + scrollSlowdown * TA::elapsedTime);
+            }
+        }
+        scroll += scrollVelocity;
+    } else {
+        scroll += controller->getDirectionVector().y * scrollKeySpeed * TA::elapsedTime;
+    }
+    scroll = std::clamp(scroll, 0.0F, getMaxScroll());
+
+    if(controller->isJustPressed(TA_BUTTON_B) || backButton.isReleased()) {
+        backSound.play();
+        return TA_MAIN_MENU_DATA_SELECT;
+    }
+
+    return TA_MAIN_MENU_ACHIEVEMENTS;
+}
+
+void TA_AchievementsSection::drawFillRect(float x, float y, float w, float h, int r, int g, int b) {
+    SDL_SetRenderDrawColor(TA::renderer, r * baseAlpha / 255, g * baseAlpha / 255, b * baseAlpha / 255, 255);
+    SDL_FRect rect = {x * TA::scaleFactor, y * TA::scaleFactor, w * TA::scaleFactor, h * TA::scaleFactor};
+    SDL_RenderFillRect(TA::renderer, &rect);
+}
+
+void TA_AchievementsSection::drawCheckbox(float x, float y, bool checked) {
+    drawFillRect(x, y, boxSize, boxSize, 136, 119, 136);
+    drawFillRect(x + 1, y + 1, boxSize - 2, boxSize - 2, 0, 0, 0);
+    if(!checked) {
+        return;
+    }
+
+    // 9x9 check mark, drawn as pixels
+    static const char* const art[9] = {
+        "........G",
+        ".......GG",
+        "......GGG",
+        "G....GGG.",
+        "GG..GGG..",
+        "GGGGGG...",
+        ".GGGG....",
+        "..GG.....",
+        "...G.....",
+    };
+    for(int py = 0; py < 9; py++) {
+        for(int px = 0; px < 9; px++) {
+            if(art[py][px] == 'G') {
+                drawFillRect(x + 1 + px, y + 1 + py, 1, 1, 64, 232, 88);
+            }
+        }
+    }
+}
+
+void TA_AchievementsSection::draw() {
+    alpha = baseAlpha;
+    const float top = listTop, bottom = getListBottom();
+    const float boxX = static_cast<float>(TA::screenWidth) - boxRight - boxSize;
+
+    for(int index = 0; index < static_cast<int>(rows.size()); index++) {
+        const Row& row = rows[index];
+        float y = top + row.y - scroll;
+        if(y + row.height < top || y > bottom) {
+            continue;
+        }
+
+        font.setAlpha(alpha);
+        for(const std::string& line : row.nameLines) {
+            if(y >= top && y + 8 <= bottom) {
+                font.drawText({textLeft, y}, line, {-1, 0});
+            }
+            y += lineHeight;
+        }
+        font.setAlpha(alpha * 5 / 8);
+        for(const std::string& line : row.descriptionLines) {
+            if(y >= top && y + 8 <= bottom) {
+                font.drawText({textLeft, y}, line, {-1, 0});
+            }
+            y += lineHeight;
+        }
+
+        float boxY = top + row.y - scroll + (row.height - boxSize) / 2;
+        if(boxY >= top && boxY + boxSize <= bottom) {
+            drawCheckbox(boxX, boxY, TA::achievements::isUnlocked(index));
+        }
+    }
+
+    int unlocked = 0;
+    for(int index = 0; index < TA::achievements::getCount(); index++) {
+        unlocked += TA::achievements::isUnlocked(index) ? 1 : 0;
+    }
+    std::string counter = std::to_string(unlocked) + "/" + std::to_string(TA::achievements::getCount());
+    font.setAlpha(alpha);
+    font.drawText({static_cast<float>(TA::screenWidth) - font.getTextWidth(counter, {-1, 0}) - 8, 12}, counter, {-1, 0});
+}
